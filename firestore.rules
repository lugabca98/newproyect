rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------
    // DEFAULT DENY: Cierre total por defecto
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // FUNCIONES DE CONTROL DE ACCESO
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // AUTORIDAD ADMINISTRATIVA: Custom Claims, email del creador o registro en /admins/
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'lugabca98@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validación de usuario activo: usuarios autenticados que no estén con status 'blocked'
    function isActiveUser() {
      return isSignedIn() && (
        isAdmin() ||
        !exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.status != 'blocked'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------
    // 1. PERFILES PÚBLICOS (/publicProfiles/{userId})
    // -------------------------------------------------------------
    match /publicProfiles/{userId} {
      // Solo usuarios activos pueden leer
      allow read: if isActiveUser();

      // Creación durante el registro/login
      allow create: if isSignedIn() && (
        (
          isOwner(userId) && 
          incoming().role == 'user' && 
          incoming().status == 'active' && 
          incoming().verified == false &&
          incoming().likesCount == 0 &&
          incoming().matchesCount == 0
        ) ||
        isAdmin()
      );

      // Edición de perfil por el propio usuario (solo campos permitidos) o admin
      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(userId) &&
          isActiveUser() &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().verified == existing().verified &&
          incoming().likesCount == existing().likesCount &&
          incoming().matchesCount == existing().matchesCount &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'bio', 'photos', 'age', 'gender', 'location', 
            'occupation', 'interests', 'lastActive'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 2. PERFILES PRIVADOS (/users/{userId})
    // -------------------------------------------------------------
    match /users/{userId} {
      // El propio usuario o admin puede leer
      allow read: if isSignedIn() && (
        (isOwner(userId) && isActiveUser()) || 
        isAdmin()
      );

      allow create: if isSignedIn() && (
        (
          isOwner(userId) && 
          incoming().role == 'user' && 
          incoming().status == 'active' && 
          incoming().verified == false &&
          incoming().likesCount == 0 &&
          incoming().matchesCount == 0
        ) ||
        isAdmin()
      );

      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(userId) &&
          isActiveUser() &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().verified == existing().verified &&
          incoming().likesCount == existing().likesCount &&
          incoming().matchesCount == existing().matchesCount &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'bio', 'photos', 'age', 'gender', 'location', 
            'occupation', 'interests', 'preferences', 'lastActive'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 3. REGISTRO DE ADMINISTRADORES (/admins/{adminId})
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. SWIPES (/swipes/{swipeId})
    // Formato determinístico: sw_{swiperId}_{targetId}
    // -------------------------------------------------------------
    match /swipes/{swipeId} {
      allow read: if isActiveUser() && (
        request.auth.uid == resource.data.swiperId || 
        request.auth.uid == resource.data.targetId ||
        isAdmin()
      );

      allow create: if isActiveUser() && 
        request.auth.uid == incoming().swiperId &&
        incoming().targetId != request.auth.uid &&
        incoming().type in ['like', 'pass', 'superlike'] &&
        swipeId == ('sw_' + request.auth.uid + '_' + incoming().targetId);

      allow update: if false; // Inmutables
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. MATCHES (/matches/{matchId})
    // Validación recíproca criptográfica de likes cruzados
    // -------------------------------------------------------------
    match /matches/{matchId} {
      allow read: if isActiveUser() && (
        request.auth.uid in resource.data.userIds || 
        isAdmin()
      );

      allow create: if isActiveUser() && (
        isAdmin() || (
          request.auth.uid in incoming().userIds &&
          incoming().userIds.size() == 2 &&
          exists(/databases/$(database)/documents/swipes/$( 'sw_' + incoming().userIds[0] + '_' + incoming().userIds[1] )) &&
          exists(/databases/$(database)/documents/swipes/$( 'sw_' + incoming().userIds[1] + '_' + incoming().userIds[0] )) &&
          get(/databases/$(database)/documents/swipes/$( 'sw_' + incoming().userIds[0] + '_' + incoming().userIds[1] )).data.type in ['like', 'superlike'] &&
          get(/databases/$(database)/documents/swipes/$( 'sw_' + incoming().userIds[1] + '_' + incoming().userIds[0] )).data.type in ['like', 'superlike']
        )
      );

      allow update: if isActiveUser() && (
        (request.auth.uid in resource.data.userIds && incoming().userIds == existing().userIds) || 
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 6. MENSAJES DE CHAT PRIVADOS (/messages/{messageId})
    // -------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isActiveUser() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId || 
        isAdmin()
      );

      allow create: if isActiveUser() && (
        request.auth.uid == incoming().senderId &&
        incoming().receiverId != incoming().senderId &&
        exists(/databases/$(database)/documents/matches/$(incoming().matchId)) &&
        request.auth.uid in get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.userIds &&
        incoming().receiverId in get(/databases/$(database)/documents/matches/$(incoming().matchId)).data.userIds
      );

      // Únicamente el destinatario puede marcar como leído ('read')
      allow update: if isActiveUser() && (
        isAdmin() || (
          isOwner(resource.data.receiverId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        )
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 7. REGISTRO DE AUDITORÍA (/auditLogs/{logId})
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && incoming().adminUid == request.auth.uid;
      allow update, delete: if false; // Inmutable
    }

    // -------------------------------------------------------------
    // 8. REPORTES (/reports/{reportId})
    // -------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isActiveUser() && incoming().reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
  }
}

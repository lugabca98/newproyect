rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. PERFILES PÚBLICOS (/publicProfiles/{userId})
    // Lectura y escritura abierta para permitir el descubrimiento entre celulares y dispositivos
    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. PERFILES PRIVADOS (/users/{userId})
    // Sincronización transparente de cuentas registradas en móviles y web
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. REGISTRO DE ADMINISTRADORES (/admins/{adminId})
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // 4. SWIPES (/swipes/{swipeId})
    match /swipes/{swipeId} {
      allow read, write: if true;
    }

    // 5. MATCHES (/matches/{matchId})
    match /matches/{matchId} {
      allow read, write: if true;
    }

    // 6. MENSAJES DE CHAT (/messages/{messageId})
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // 7. AUDITORÍA (/auditLogs/{logId})
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // 8. REPORTES (/reports/{reportId})
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // 9. CUENTAS ELIMINADAS (/deletedAccounts/{email})
    match /deletedAccounts/{email} {
      allow read, write: if true;
    }

    // 10. CREDENCIALES Y REGISTROS PENDIENTES
    match /credentials/{email} {
      allow read, write: if true;
    }
    match /pendingRegistrations/{email} {
      allow read, write: if true;
    }
  }
}

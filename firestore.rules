rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny: Ningún acceso no autorizado
    match /{document=**} {
      allow read, write: if false;
    }

    // Funciones de validación criptográfica y autenticación Firebase
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // El rol admin se verifica mediante Custom Claims del token JWT o en la colección reservada /admins/
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'lugabca98@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -------------------------------------------------------------
    // 1. PERFILES PÚBLICOS (/publicProfiles/{userId})
    // Accesible para que otros usuarios descubran el perfil en el feed.
    // NO CONTIENE EMAIL, PREFERENCIAS PRIVADAS NI DATOS DE AUDITORÍA.
    // -------------------------------------------------------------
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isOwner(userId) &&
        (incoming().role == 'user' || isAdmin()) &&
        (incoming().status == 'active') &&
        (incoming().verified == false || isAdmin())
      );

      // Los usuarios solo pueden actualizar campos visuales de su propio perfil
      // ESTÁ PROHIBIDO auto-asignarse role='admin', cambiar status o verified
      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().verified == existing().verified &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'bio', 'photos', 'age', 'gender', 'location', 
            'occupation', 'interests', 'lastActive', 
            'distanceKm', 'likesCount', 'matchesCount'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 2. PERFILES PRIVADOS (/users/{userId})
    // Contiene el email, preferencias de distancia/edad y configuración privada.
    // SOLAMENTE EL PROPIO USUARIO O UN ADMINISTRADOR PUEDEN LEER O MODIFICAR.
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      allow create: if isSignedIn() && (
        isOwner(userId) &&
        (incoming().role == 'user' || isAdmin()) &&
        (incoming().status == 'active')
      );

      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(userId) &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().verified == existing().verified
        )
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 3. REGISTRO DE ADMINISTRADORES (/admins/{adminId})
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 4. SWIPES (/swipes/{swipeId})
    // -------------------------------------------------------------
    match /swipes/{swipeId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.swiperId || 
        request.auth.uid == resource.data.targetId ||
        isAdmin()
      );

      // El swiperId DEBE coincidir con el UID autenticado en Firebase
      allow create: if isSignedIn() && request.auth.uid == incoming().swiperId;

      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 5. MATCHES (/matches/{matchId})
    // -------------------------------------------------------------
    match /matches/{matchId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.userIds || 
        isAdmin()
      );

      // Requiere que el creador forme parte de userIds
      allow create: if isSignedIn() && (
        request.auth.uid in incoming().userIds
      );

      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.userIds || 
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 6. MENSAJES DE CHAT (/messages/{messageId})
    // -------------------------------------------------------------
    match /messages/{messageId} {
      // Solo los participantes directos (sender/receiver) o el Admin pueden leer
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.senderId || 
        request.auth.uid == resource.data.receiverId || 
        isAdmin()
      );

      // No se puede suplantar la identidad al enviar mensajes
      allow create: if isSignedIn() && (
        request.auth.uid == incoming().senderId
      );

      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.receiverId || 
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------
    // 7. AUDITORÍA (/auditLogs/{logId})
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------
    // 8. REPORTES (/reports/{reportId})
    // -------------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}

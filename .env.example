# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Email SMTP / Resend Configuration (for real email verification & password recovery codes)
# Option 1: Resend API (Recommended for production)
RESEND_API_KEY=

# Option 2: Gmail SMTP (Use your Gmail address + App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option 3: Custom SMTP Server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Sender address (e.g., "Vulnerable" <noreply@tudominio.com>)
EMAIL_FROM=

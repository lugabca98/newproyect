# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Email Delivery Services (for real inbox delivery of 6-digit codes & recovery emails)
# Option 1: Resend API (Recommended - get key at https://resend.com)
RESEND_API_KEY=

# Option 2: Brevo / Sendinblue (Free 300 emails/day - get key at https://brevo.com)
BREVO_API_KEY=

# Option 3: SendGrid API
SENDGRID_API_KEY=

# Option 4: Gmail SMTP (Use your Gmail address + 16-character App Password from Google Account > Security > 2-Step Verification > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option 5: Custom SMTP Server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Sender address (e.g., "Vulnerable" <noreply@tudominio.com> or your verified sender)
EMAIL_FROM=
